{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run vercel-build",
        "distDir": "."
      }
    },
    {
      "src": "api/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["staticfiles/**", "templates/**", "static/**"]
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/api/wsgi.py" },
    { "src": "/media/(.*)", "dest": "/api/wsgi.py" },
    { "src": "/(.*)", "dest": "/api/wsgi.py" }
  ]
}
