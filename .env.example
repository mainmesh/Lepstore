# Example environment variables for LepStore
# REQUIRED
SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=lepstore.settings
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DATABASE_URL=postgres://USER:PASS@HOST:PORT/DBNAME

# Optional (Stripe)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AWS / S3 (if using django-storages)
USE_S3=False
STATICFILES_ON_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Other
# Set to true in production to enable security hardening
# DEBUG=False above will already set production security settings
