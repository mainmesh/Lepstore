{
  "name": "lepstore-tailwind",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./static/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./static/css/styles.css --watch",
    "vercel-build": "npm run build:css && python manage.py collectstatic --noinput",
    "build": "npm run vercel-build"
  }
}
